# Conspodium Shared Hosting Apache / LiteSpeed Configuration (.htaccess)
Options -Indexes +FollowSymLinks
DirectoryIndex index.html index.php install.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Installer clean URL rewrite (/install -> install.php)
    RewriteRule ^install/?$ install.php [L]

    # 2. Direct pass-through for existing files in root (CSS, JS, Images, Fonts, PHP scripts)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 3. Sitemap rewrite
    RewriteRule ^sitemap\.xml$ api/sitemap.php [L]

    # 4. Handle Root URL (check root first, then public/)
    RewriteCond %{REQUEST_URI} ^/$
    RewriteCond %{DOCUMENT_ROOT}/index.html -f
    RewriteRule ^$ index.html [L]

    RewriteCond %{REQUEST_URI} ^/$
    RewriteCond %{DOCUMENT_ROOT}/public/index.html -f
    RewriteRule ^$ public/index.html [L]

    # 5. Routing if public/ directory exists (serve assets & pages from public/ if not in root)
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
    RewriteRule ^(.*)$ public/$1 [L]

    # 6. Clean URL Rewrites for Subpages (Subfolder setup if public/ exists)
    RewriteRule ^dashboard/?$ public/dashboard/index.html [L]
    RewriteRule ^dashboard/(.*)$ public/dashboard/$1 [L]
    RewriteRule ^stories/?$ public/stories/index.html [L]
    RewriteRule ^about-us/?$ public/about-us/index.html [L]
    RewriteRule ^contact-us/?$ public/contact-us/index.html [L]
    RewriteRule ^sponsorship/?$ public/sponsorship/index.html [L]
    RewriteRule ^advert/?$ public/advert/index.html [L]
    RewriteRule ^submit-story/?$ public/submit-story/index.html [L]
    RewriteRule ^category/(.*)$ public/category/index.html [L]
    RewriteRule ^post/(.*)$ public/post/index.html [L]
    RewriteRule ^story/(.*)$ public/post/index.html [L]
    RewriteRule ^forum/?$ public/forum/index.html [L]
    RewriteRule ^forum/thread/(.*)$ public/forum/thread/index.html [L]

    # 7. Direct setup fallback (if public contents uploaded directly into public_html root)
    RewriteRule ^dashboard/?$ dashboard/index.html [L]
    RewriteRule ^stories/?$ stories/index.html [L]
    RewriteRule ^about-us/?$ about-us/index.html [L]
    RewriteRule ^contact-us/?$ contact-us/index.html [L]
    RewriteRule ^sponsorship/?$ sponsorship/index.html [L]
    RewriteRule ^advert/?$ advert/index.html [L]
    RewriteRule ^submit-story/?$ submit-story/index.html [L]
    RewriteRule ^category/(.*)$ category/index.html [L]
    RewriteRule ^post/(.*)$ post/index.html [L]
    RewriteRule ^story/(.*)$ post/index.html [L]
    RewriteRule ^forum/?$ forum/index.html [L]
    RewriteRule ^forum/thread/(.*)$ forum/thread/index.html [L]
</IfModule>

# Protect SQLite database files and sensitive configs from HTTP download
<IfModule mod_authz_core.c>
    <FilesMatch "\.(db|lock|sqlite)$">
        Require all denied
    </FilesMatch>
</IfModule>
